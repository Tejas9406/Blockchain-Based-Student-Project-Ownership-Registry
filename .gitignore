# ==========================================
# Git Ignore for Student Project Ownership Registry
# Monorepo: Frontend, Backend, Blockchain
# ==========================================

# Environment variables & secrets (CRITICAL: Never commit secrets!)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
secrets.json

# Node & Frontend / Blockchain build artifacts
node_modules/
dist/
build/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm

# Python & Backend artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
coverage/
.nyc_output/
.pytest_cache/
htmlcov/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Hardhat & Smart Contracts
artifacts/
cache/
typechain/
typechain-types/
hardhat.log

# Database data & Persistent volumes
*.sqlite
*.sqlite3
*.db
pgdata/
data/

# IDE & Editor specific files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Operating System specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs & Temporary files
logs/
*.log
*.tmp
*.temp
scratch/
