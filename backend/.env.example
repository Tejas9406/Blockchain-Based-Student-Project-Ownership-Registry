# ==========================================
# Backend Environment Configuration (Developer 2)
# ==========================================

ENVIRONMENT=development
API_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection (PostgreSQL)
POSTGRES_USER=registry_user
POSTGRES_PASSWORD=registry_password_dev
POSTGRES_DB=project_registry_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://registry_user:registry_password_dev@localhost:5432/project_registry_db

# Web3 / Blockchain Node URL
WEB3_PROVIDER_URI=http://127.0.0.1:8545
