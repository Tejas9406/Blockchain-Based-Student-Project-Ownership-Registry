# ==============================================================================
# Blockchain-Based Student Project Ownership Registry (CYB05)
# Monorepo Master Environment Configuration Template
# NOTE: Copy this to .env or use module-specific .env files in frontend/, backend/, blockchain/
# NEVER COMMIT ACTUAL .env FILES OR SECRETS TO GIT
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend & API Configuration (Developer 2)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
API_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL) (Developer 2)
# ------------------------------------------------------------------------------
POSTGRES_USER=registry_user
POSTGRES_PASSWORD=registry_password_dev
POSTGRES_DB=project_registry_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full SQLAlchemy Connection URL
DATABASE_URL=postgresql://registry_user:registry_password_dev@localhost:5432/project_registry_db

# ------------------------------------------------------------------------------
# Frontend Configuration (Developer 1)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_PORT=5173

# ------------------------------------------------------------------------------
# Blockchain Configuration (Developer 3)
# ------------------------------------------------------------------------------
HARDHAT_NETWORK=localhost
LOCAL_RPC_URL=http://127.0.0.1:8545
